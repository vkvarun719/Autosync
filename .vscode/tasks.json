{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AutoSync: Start Dev Server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Ready in.*|.*Starting.*",
          "endsPattern": ".*Compiled.*|.*Local:.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "AutoSync: Start Production Server",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "group": "build"
    },
    {
      "label": "AutoSync: Open Prisma Studio (Database GUI)",
      "type": "shell",
      "command": "npx prisma studio",
      "problemMatcher": []
    },
    {
      "label": "AutoSync: Sync Database Schema",
      "type": "shell",
      "command": "npx prisma db push && npx prisma generate",
      "problemMatcher": []
    }
  ]
}
